{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AER Home event (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "type",
    "createdAt",
    "source",
    "entityId",
    "severity",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "data": {
      "type": "object"
    }
  }
}
