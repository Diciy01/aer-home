# AER Remote Gateway: the only public TCP port of AER HOME (ADR-017/018).
# Separate system user: the Gateway can neither read Core's database nor
# the owner token; it holds only its own agent credential (kind=gateway),
# passed as a systemd credential. Never enabled automatically.
[Unit]
Description=AER Remote Gateway
After=network-online.target aer-core.service
Wants=network-online.target
Requires=aer-core.service

[Service]
Type=simple
User=aer-gateway
Group=aer-gateway
ExecStart=/usr/local/bin/aer-remote-gateway -config /etc/aer-home/remote-gateway.json
Restart=on-failure
RestartSec=5
LoadCredential=gateway.token:/etc/aer-home/gateway.token
# TLS certificate/key (self-signed ECDSA, created on first start; clients
# pin it — back it up, a new key means re-pinning every device).
StateDirectory=aer-remote-gateway
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
# Listening on 443 directly instead of 8443 needs exactly this capability:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=256M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
